# App
APP_NAME=Cosmozpay
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cosmozpay
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security / Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

BANK_ACCOUNT_ENCRYPTION_KEY=
BANK_ACCOUNT_ENCRYPTION_KEY_VERSION=1
# Mail
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment providers
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_API_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
KORAPAY_SECRET_KEY=

# VTU providers
AIDAPAY_API_KEY=
VTUNG_API_KEY=
CLUBKONNECT_API_KEY=
VTUGATE_API_KEY=

# SMS providers
TERMII_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Provider and retry settings
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5
MAX_RETRY_DELAY=30
VIRTUAL_ACCOUNT_MAX_RETRIES=6
VIRTUAL_ACCOUNT_INITIAL_RETRY_DELAY_SECONDS=60
VIRTUAL_ACCOUNT_BACKOFF_MULTIPLIER=2
VIRTUAL_ACCOUNT_MAX_RETRY_DELAY_SECONDS=86400
VIRTUAL_ACCOUNT_RETRY_JOB_INTERVAL_SECONDS=60
VIRTUAL_ACCOUNT_RETRY_JOB_BATCH_SIZE=100
VIRTUAL_ACCOUNT_RETRY_JOB_LOCK_TIMEOUT_SECONDS=60
VIRTUAL_ACCOUNT_RETRY_JOB_RETRY_INTERVAL_SECONDS=60
